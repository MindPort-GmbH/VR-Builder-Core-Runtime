.console-window {
    flex-grow: 1;
    background-color: rgba(32, 32, 32, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(0, 61, 49);
    overflow: hidden;
}

.console-titlebar {
    flex-direction: row;
    align-items: center;
    height: 64px;
    flex-shrink: 0;
    background-color: rgb(0, 61, 49);
    padding-left: 10px;
    padding-right: 10px;
}

.console-logo {
    width: 48px;
    height: 48px;
    background-image: resource('Textures/VRBuilder-StandaloneLogo-256');
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.console-title {
    flex-grow: 1;
    margin-left: 12px;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.console-clear {
    height: 40px;
    min-width: 80px;
    flex-shrink: 0;
    margin-right: 8px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    border-width: 0;
}

.console-clear:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

.console-close {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(122, 0, 0);
    border-radius: 8px;
    border-width: 0;
}

.console-close:hover {
    background-color: rgb(165, 0, 0);
}

.console-list {
    flex-grow: 1;
}

.console-list .unity-collection-view__item--alternative-background {
    background-color: rgba(255, 255, 255, 0.05);
}

.console-list .unity-collection-view__item:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.console-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
}

.console-icon {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.console-icon--log {
    background-color: rgb(53, 116, 219);
}

.console-icon--warning {
    background-color: rgb(217, 164, 0);
}

.console-icon--error {
    background-color: rgb(196, 43, 28);
}

.console-row__message {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
    font-size: 24px;
    color: rgb(230, 230, 230);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
